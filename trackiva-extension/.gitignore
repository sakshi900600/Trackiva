# .gitignore for Trackiva Extension

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace

# Dependencies
node_modules/
package-lock.json

# Build files
dist/
build/
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Temporary files
temp/
tmp/
.cache/

# OS
*.exe
*.app

# Testing
.test-results/
coverage/

# Chrome extension specific
# (Uncomment if using webpack or build tools)
# /public/
# /src/*.map
