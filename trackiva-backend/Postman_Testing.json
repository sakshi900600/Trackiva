{
  "info": {
    "name": "Trackiva API (Auto Test)",
    "_postman_id": "trackiva-auto",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "resumeId", "value": "" },
    { "key": "todoId", "value": "" },
    { "key": "qaId", "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@gmail.com\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Login (Auto Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "pm.environment.set('token', res.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@mail.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job (Save ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "pm.environment.set('jobId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Google\",\n  \"role\": \"Frontend Developer\",\n  \"platform\": \"LinkedIn\",\n  \"status\": \"applied\"\n}"
            }
          }
        },
        {
          "name": "Get Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/jobs"
          }
        }
      ]
    },

    {
      "name": "Resume",
      "item": [
        {
          "name": "Upload Resume (Save ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "pm.environment.set('resumeId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/resume",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "resume", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "Interview Prep",
      "item": [
        {
          "name": "Create QA (Save ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "pm.environment.set('qaId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/interview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Tell me about yourself\",\n  \"answer\": \"I am a frontend dev...\",\n  \"category\": \"hr\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Todo",
      "item": [
        {
          "name": "Create Todo (Save ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "pm.environment.set('todoId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/todo",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Apply to 5 jobs\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Quote",
      "item": [
        {
          "name": "Get Quote",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/quote"
          }
        }
      ]
    },

    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/analytics"
          }
        }
      ]
    }

  ]
}